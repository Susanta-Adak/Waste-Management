SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL
DB_NAME=notification_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@waste-management.io

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push (Firebase)
FIREBASE_CREDENTIALS_PATH=

# Kafka
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-svc
KAFKA_TOPICS=waste-events,bin-events,payment-events
